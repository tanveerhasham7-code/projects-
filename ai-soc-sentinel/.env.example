# Copy to .env and replace every placeholder. Never commit .env.
APP_ENV=development
WEBHOOK_TOKEN=replace-with-a-long-random-secret
DATABASE_PATH=./data/ai_soc_sentinel.db
RISK_EMAIL_THRESHOLD=70

# AI is optional and disabled by default.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=15

# SMTP notification. Use a dedicated lab mailbox/app password.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=soc-sentinel@example.com
SOC_ANALYST_EMAIL=
SMTP_STARTTLS=true
